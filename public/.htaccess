# cPanel / Apache: compression + long-lived caching for hashed assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/wasm
</IfModule>
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType image/webp .webp
  AddType video/webm .webm
  AddType image/ktx2 .ktx2
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^assets/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|svg|mp4|webm|ktx2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
